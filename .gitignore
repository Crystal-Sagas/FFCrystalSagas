## BYOND - Ignore compiled files and other files generated during compilation.
*.dmb
*.rsc
*.lk
*.int

## BYOND - Ignore runtime autogenerated config
/cfg

## Game - Ignore save data files
# All saves now go to Data/ folder with proper organization:
# - Data/Players/ - Player save files
# - Data/World/ - World objects and game data archives
# - Data/World/Archives/ - Game data (perks, weapons, materials, etc.)
# - Data/World/Bans.sav - Ban list
# - Data/Logs/ - Server logs
# - Data/ChatLogs/ - Chat logs

# Legacy save locations (kept for backwards compatibility during migration)
Ban Save
Perks
Weapons
Materials
Recipes
Summons
Bestiary

# Data folder contents (runtime data, not source)
/Data/Players/
/Data/World/
/Data/Logs/
/Data/ChatLogs/

# Keep the Data folder structure files
!Data/.gitkeep
!Data/Players/.gitkeep
!Data/World/.gitkeep
!Data/World/Archives/.gitkeep

/ChatLogs
/data
/Save
