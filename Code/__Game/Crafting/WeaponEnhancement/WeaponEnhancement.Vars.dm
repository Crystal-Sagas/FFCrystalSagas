/**
 * Weapon Enhancement Variables
 *
 * Additional variables needed for the weapon enhancement systems
 * (Gilding, Mastercrafting, Enchanting, etc.)
 */

/obj/item/var
	/// Type of enchantment applied (armor/weapon)
	entype
	/// Whether item has mythic enchantment (0 or 1)
	mythic = 0
	/// Whether item is mastercrafted (0 or 1) - Namazu rework feature
	mastercraft = 0
	/// Whether item is gilded (0 or 1)
	gilded = 0
