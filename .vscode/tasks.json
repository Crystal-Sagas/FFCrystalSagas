{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "dreammaker",
			"dme": "RoleplayProject.dme",
			"presentation": {
				"echo": true,
				"reveal": "never",
				"revealProblems": "onProblem",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": [
				"$dreammaker"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"label": "dm: build - RoleplayProject.dme"
		},
		{
			"label": "dm: build - RoleplayProject.dme",
			"type": "shell",
			"command": "echo Skipping direct build; use existing Dream Maker task via VS Code task runner",
			"group": "build"
		}
	]
}
